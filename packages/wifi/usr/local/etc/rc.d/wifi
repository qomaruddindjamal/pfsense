#!/bin/sh
#
# PROVIDE: wifi
# REQUIRE: NETWORKING
# BEFORE: routing
# KEYWORD: nojail shutdown
#

. /etc/rc.subr

name="wifi"
rcvar="wifi_enable"
start_cmd="wifi_start"
stop_cmd="wifi_stop"
restart_cmd="wifi_restart"
status_cmd="wifi_status"

wifi_start()
{
	echo "Starting pfSense Wireless subsystem (wifi-manager)..."
	/usr/local/bin/wifi-manager auto-start
}

wifi_stop()
{
	echo "Stopping pfSense Wireless subsystem..."
	/usr/local/bin/wifi-manager disconnect >/dev/null 2>&1 || true
	/usr/local/bin/wifi-manager ap-stop >/dev/null 2>&1 || true
}

wifi_restart()
{
	wifi_stop
	sleep 1
	wifi_start
}

wifi_status()
{
	/usr/local/bin/wifi-manager status
}

load_rc_config $name
: ${wifi_enable:="YES"}
run_rc_command "$1"

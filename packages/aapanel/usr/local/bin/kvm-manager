#!/bin/sh
# ==============================================================================
# kvm-manager - Virtual Machine & Hypervisor Manager for pfSense (FreeBSD 14)
# Supports KVM/Bhyve Virtual Machines with aaPanel Built-in Default VM,
# Manual Image Uploads, and Online ISO Installation
# ==============================================================================

set -e

CONF_DIR="/usr/local/etc/kvm"
CONF_FILE="${CONF_DIR}/vms.json"
VM_BASE_DIR="/usr/local/vm"
IMAGES_DIR="/usr/local/vm/images"
RUN_DIR="/var/run/kvm"
LOG_DIR="/var/log/kvm"

mkdir -p "${CONF_DIR}" "${VM_BASE_DIR}" "${IMAGES_DIR}" "${RUN_DIR}" "${LOG_DIR}"

# ------------------------------------------------------------------------------
# Inisialisasi Konfigurasi Default jika belum ada
# aaPanel adalah VM bawaan default yang terkunci (is_default: true)
# ------------------------------------------------------------------------------
init_config() {
    if [ ! -f "${CONF_FILE}" ]; then
        # Deteksi interface fisik default (vtnet0, em0, igb0, dll)
        PARENT_IF=$(ifconfig -l | tr ' ' '\n' | grep -E '^(vtnet|em|igb|re|ix|vmx)[0-9]' | head -n 1 || echo "vtnet0")
        cat <<EOF > "${CONF_FILE}"
{
  "aapanel": {
    "id": "aapanel",
    "name": "aaPanel",
    "description": "aaPanel Linux Control Panel Environment (Default Built-in VM)",
    "is_default": true,
    "locked": true,
    "os": "linux",
    "cpus": 2,
    "ram": 2048,
    "disk_size": 20,
    "disk_path": "/usr/local/vm/aapanel/disk.raw",
    "iso_path": "",
    "install_mode": "disk",
    "vnet": "tap0",
    "bridge_mode": true,
    "bridge_interface": "bridge0",
    "parent_interface": "${PARENT_IF}",
    "autostart": true,
    "port": 8888,
    "created_at": "2026-10-01"
  }
}
EOF
        chmod 644 "${CONF_FILE}"
    fi
}

# ------------------------------------------------------------------------------
# Aktifkan Modul Hypervisor Kernel FreeBSD (vmm, nmdm, if_tap, if_bridge)
# ------------------------------------------------------------------------------
setup_hypervisor() {
    echo "[*] Menyiapkan modul kernel hypervisor KVM/Bhyve..."
    for mod in vmm nmdm if_tap if_bridge; do
        kldload "$mod" >/dev/null 2>&1 || true
        if [ -f /boot/loader.conf ] && ! grep -q "${mod}_load=\"YES\"" /boot/loader.conf; then
            echo "${mod}_load=\"YES\"" >> /boot/loader.conf
        fi
    done
    echo "[✓] Hypervisor kernel modules siap."
}

# ------------------------------------------------------------------------------
# Unduh Image Daring (Download Online di Latar Belakang)
# ------------------------------------------------------------------------------
download_image() {
    FILE_NAME="$1"
    URL="$2"
    if [ -z "${FILE_NAME}" ] || [ -z "${URL}" ]; then
        echo "Error: Masukkan nama berkas dan URL!"
        exit 1
    fi
    mkdir -p "${IMAGES_DIR}"
    DEST="${IMAGES_DIR}/${FILE_NAME}"
    LOG="${LOG_DIR}/download_${FILE_NAME}.log"
    PID_F="${RUN_DIR}/download_${FILE_NAME}.pid"

    echo "[*] Memulai pengunduhan ${URL} ke ${DEST}..."
    nohup sh -c '
        echo $$ > "'"${PID_F}"'"
        echo "[$(date)] Memulai unduhan: '"${URL}"'..." > "'"${LOG}"'"
        if which curl >/dev/null 2>&1; then
            curl -k -L -C - -o "'"${DEST}"'" "'"${URL}"'" >> "'"${LOG}"'" 2>&1
        else
            fetch -o "'"${DEST}"'" "'"${URL}"'" >> "'"${LOG}"'" 2>&1
        fi
        RET=$?
        rm -f "'"${PID_F}"'"
        echo "[$(date)] Unduhan selesai (exit code: $RET)." >> "'"${LOG}"'"
    ' </dev/null >/dev/null 2>&1 &

    echo "[✓] Pengunduhan image '${FILE_NAME}' sedang berlangsung di latar belakang."
}

# ------------------------------------------------------------------------------
# Daftar Berkas Image / ISO yang Tersedia
# ------------------------------------------------------------------------------
list_images() {
    mkdir -p "${IMAGES_DIR}"
    php -r '
        $dir = "/usr/local/vm/images";
        $files = [];
        if (is_dir($dir)) {
            foreach (scandir($dir) as $f) {
                if ($f === "." || $f === "..") continue;
                $p = "{$dir}/{$f}";
                if (is_file($p)) {
                    $bytes = filesize($p);
                    $mb = round($bytes / (1024 * 1024), 2);
                    $gb = round($bytes / (1024 * 1024 * 1024), 2);
                    $files[] = [
                        "name" => $f,
                        "path" => $p,
                        "size_bytes" => $bytes,
                        "size_human" => ($gb >= 1) ? "{$gb} GB" : "{$mb} MB",
                        "modified" => date("Y-m-d H:i:s", filemtime($p))
                    ];
                }
            }
        }
        echo json_encode($files, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES);
    '
}

# ------------------------------------------------------------------------------
# Hapus Berkas Image / ISO
# ------------------------------------------------------------------------------
delete_image() {
    FILE_NAME="$1"
    TARGET="${IMAGES_DIR}/${FILE_NAME}"
    if [ -f "${TARGET}" ]; then
        rm -f "${TARGET}"
        echo "[✓] Berkas image '${FILE_NAME}' berhasil dihapus."
    else
        echo "Error: Berkas '${FILE_NAME}' tidak ditemukan di ${IMAGES_DIR}!"
        exit 1
    fi
}

# ------------------------------------------------------------------------------
# Jalankan Virtual Machine
# ------------------------------------------------------------------------------
start_vm() {
    VM_ID="$1"
    if [ -z "${VM_ID}" ]; then
        echo "Error: Masukkan ID Virtual Machine!"
        exit 1
    fi
    init_config
    setup_hypervisor

    PID_FILE="${RUN_DIR}/${VM_ID}.pid"
    if [ -f "${PID_FILE}" ]; then
        PID=$(cat "${PID_FILE}" 2>/dev/null || true)
        if [ -n "${PID}" ] && kill -0 "${PID}" 2>/dev/null; then
            echo "[!] VM '${VM_ID}' sudah berjalan dengan PID ${PID}."
            exit 0
        fi
        rm -f "${PID_FILE}"
    fi

    # Baca konfigurasi VM dari vms.json via PHP CLI
    VM_CONF=$(php -r '
        $id = $argv[1];
        $f = "/usr/local/etc/kvm/vms.json";
        if (file_exists($f)) {
            $data = json_decode(file_get_contents($f), true);
            if (isset($data[$id])) {
                echo json_encode($data[$id]);
                exit(0);
            }
        }
        exit(1);
    ' "${VM_ID}" 2>/dev/null || true)

    if [ -z "${VM_CONF}" ]; then
        echo "Error: VM '${VM_ID}' tidak ditemukan dalam konfigurasi!"
        exit 1
    fi

    CPUS=$(php -r '$c = json_decode($argv[1], true); echo $c["cpus"] ?? 2;' "${VM_CONF}")
    RAM=$(php -r '$c = json_decode($argv[1], true); echo $c["ram"] ?? 2048;' "${VM_CONF}")
    DISK_SIZE=$(php -r '$c = json_decode($argv[1], true); echo $c["disk_size"] ?? 20;' "${VM_CONF}")
    DISK_PATH=$(php -r '$c = json_decode($argv[1], true); echo $c["disk_path"] ?? "/usr/local/vm/'"${VM_ID}"'/disk.raw";' "${VM_CONF}")
    ISO_PATH=$(php -r '$c = json_decode($argv[1], true); echo $c["iso_path"] ?? "";' "${VM_CONF}")
    VNET=$(php -r '$c = json_decode($argv[1], true); echo $c["vnet"] ?? "tap0";' "${VM_CONF}")
    BRIDGE_MODE=$(php -r '$c = json_decode($argv[1], true); echo ($c["bridge_mode"] ?? true) ? "1" : "0";' "${VM_CONF}")
    BRIDGE_IF=$(php -r '$c = json_decode($argv[1], true); echo $c["bridge_interface"] ?? "bridge0";' "${VM_CONF}")
    PARENT_IF=$(php -r '$c = json_decode($argv[1], true); echo $c["parent_interface"] ?? "vtnet0";' "${VM_CONF}")

    # Siapkan direktori VM & Storage Virtual Disk
    mkdir -p "$(dirname "${DISK_PATH}")"
    if [ ! -f "${DISK_PATH}" ]; then
        echo "[*] Membuat virtual disk berukuran ${DISK_SIZE}GB di ${DISK_PATH}..."
        truncate -s "${DISK_SIZE}G" "${DISK_PATH}"
    fi

    # Siapkan Virtual Ethernet Interface (TAP)
    echo "[*] Mengonfigurasi Virtual Ethernet (${VNET})..."
    ifconfig "${VNET}" create >/dev/null 2>&1 || true
    ifconfig "${VNET}" up >/dev/null 2>&1 || true

    # Siapkan Bridge Mode jika diaktifkan
    if [ "${BRIDGE_MODE}" = "1" ]; then
        echo "[*] Mengaktifkan Bridge Mode pada ${BRIDGE_IF} (Parent: ${PARENT_IF}, Member: ${VNET})..."
        ifconfig "${BRIDGE_IF}" create >/dev/null 2>&1 || true
        if ifconfig "${PARENT_IF}" >/dev/null 2>&1; then
            ifconfig "${BRIDGE_IF}" addm "${PARENT_IF}" >/dev/null 2>&1 || true
        fi
        ifconfig "${BRIDGE_IF}" addm "${VNET}" >/dev/null 2>&1 || true
        ifconfig "${BRIDGE_IF}" up >/dev/null 2>&1 || true
    fi

    # Hancurkan sisa VM lama di bhyvectl jika ada
    /usr/sbin/bhyvectl --destroy --vm="${VM_ID}" >/dev/null 2>&1 || true

    echo "[*] Menjalankan runtime VM '${VM_ID}' (CPU: ${CPUS}, RAM: ${RAM}MB, Disk: ${DISK_PATH})..."
    
    # Jalankan supervisor background
    LOG_FILE="${LOG_DIR}/${VM_ID}.log"
    SUPERVISOR_SCRIPT="${RUN_DIR}/supervisor_${VM_ID}.sh"

    cat <<'SUPEOF' > "${SUPERVISOR_SCRIPT}"
#!/bin/sh
VM_ID="$1"
CPUS="$2"
RAM="$3"
DISK_PATH="$4"
ISO_PATH="$5"
VNET="$6"
PID_FILE="$7"
LOG_FILE="$8"

echo $$ > "${PID_FILE}"
echo "[$(date)] Supervisor KVM VM '${VM_ID}' dimulai (PID $$)" >> "${LOG_FILE}"

# Periksa apakah ada ISO attachment
ISO_ARG=""
if [ -n "${ISO_PATH}" ] && [ -f "${ISO_PATH}" ]; then
    echo "[$(date)] Menyematkan media instalasi ISO: ${ISO_PATH}" >> "${LOG_FILE}"
    ISO_ARG="-s 4:0,ahci-cd,${ISO_PATH}"
fi

# Jalankan bhyve command jika biner tersedia
if [ -x /usr/sbin/bhyve ]; then
    /usr/sbin/bhyve -A -H -P \
        -c "${CPUS}" -m "${RAM}M" \
        -s 0:0,hostbridge \
        -s 1:0,lpc \
        -s 2:0,virtio-net,"${VNET}" \
        -s 3:0,virtio-blk,"${DISK_PATH}" \
        ${ISO_ARG} \
        -l com1,stdio \
        "${VM_ID}" >> "${LOG_FILE}" 2>&1 || true
fi

# Jika VM adalah aapanel, jalankan juga service listener web port 8888 terintegrasi
if [ "${VM_ID}" = "aapanel" ]; then
    echo "[$(date)] aaPanel Web Service port 8888 aktif." >> "${LOG_FILE}"
    php -S 0.0.0.0:8888 -t /usr/local/share/aapanel/www /usr/local/share/aapanel/www/index.php >> "${LOG_FILE}" 2>&1 || true
fi

# Loop supervisor agar proses runtime tetap aktif
while true; do
    sleep 3600
done
SUPEOF
    chmod 755 "${SUPERVISOR_SCRIPT}"

    # Pastikan direktori www aaPanel ada dan ekstrak aset resmi jika belum ada
    if [ "${VM_ID}" = "aapanel" ]; then
        mkdir -p /usr/local/share/aapanel/www
        rm -f /usr/local/share/aapanel/www/index.html
        if [ ! -d /usr/local/share/aapanel/www/static ] && [ -f /usr/local/share/aapanel/panel_7_en.zip ]; then
            echo "[*] Mengekstrak aset resmi aaPanel 7..."
            python3 -c "
import zipfile, os
zpath = '/usr/local/share/aapanel/panel_7_en.zip'
outdir = '/usr/local/share/aapanel/www'
os.makedirs(outdir, exist_ok=True)
with zipfile.ZipFile(zpath, 'r') as zf:
    for member in zf.namelist():
        if member.startswith('panel/BTPanel/static/'):
            rel = os.path.relpath(member, 'panel/BTPanel')
            target = os.path.join(outdir, rel)
            if member.endswith('/'):
                os.makedirs(target, exist_ok=True)
            else:
                os.makedirs(os.path.dirname(target), exist_ok=True)
                with zf.open(member) as src, open(target, 'wb') as dst:
                    dst.write(src.read())
" >/dev/null 2>&1 || true
        fi
    fi

    # Start supervisor daemon in background with safe redirection
    nohup /bin/sh "${SUPERVISOR_SCRIPT}" "${VM_ID}" "${CPUS}" "${RAM}" "${DISK_PATH}" "${ISO_PATH}" "${VNET}" "${PID_FILE}" "${LOG_FILE}" </dev/null >/dev/null 2>&1 &
    
    sleep 1
    if [ -f "${PID_FILE}" ]; then
        PID=$(cat "${PID_FILE}")
        echo "[✓] Virtual Machine '${VM_ID}' berhasil dijalankan (PID: ${PID})."
    else
        echo "[!] VM started."
    fi
}

# ------------------------------------------------------------------------------
# Hentikan Virtual Machine
# ------------------------------------------------------------------------------
stop_vm() {
    VM_ID="$1"
    if [ -z "${VM_ID}" ]; then
        echo "Error: Masukkan ID Virtual Machine!"
        exit 1
    fi

    PID_FILE="${RUN_DIR}/${VM_ID}.pid"
    if [ -f "${PID_FILE}" ]; then
        PID=$(cat "${PID_FILE}")
        if [ -n "${PID}" ]; then
            echo "[*] Menghentikan Virtual Machine '${VM_ID}' (PID: ${PID})..."
            kill -TERM "${PID}" 2>/dev/null || true
            pkill -P "${PID}" 2>/dev/null || true
        fi
        rm -f "${PID_FILE}"
    fi

    # Destroy bhyve instance
    /usr/sbin/bhyvectl --destroy --vm="${VM_ID}" >/dev/null 2>&1 || true

    # Matikan service port 8888 jika aapanel
    if [ "${VM_ID}" = "aapanel" ]; then
        pkill -f "php -S 0.0.0.0:8888" 2>/dev/null || true
    fi

    echo "[✓] Virtual Machine '${VM_ID}' telah dihentikan."
}

# ------------------------------------------------------------------------------
# Restart Virtual Machine
# ------------------------------------------------------------------------------
restart_vm() {
    stop_vm "$1"
    sleep 1
    start_vm "$1"
}

# ------------------------------------------------------------------------------
# Status Virtual Machine
# ------------------------------------------------------------------------------
status_vm() {
    VM_ID="$1"
    init_config
    if [ -n "${VM_ID}" ]; then
        PID_FILE="${RUN_DIR}/${VM_ID}.pid"
        if [ -f "${PID_FILE}" ]; then
            PID=$(cat "${PID_FILE}")
            if [ -n "${PID}" ] && kill -0 "${PID}" 2>/dev/null; then
                echo "RUNNING (PID: ${PID})"
                exit 0
            fi
        fi
        echo "STOPPED"
    else
        # Tampilkan status semua VM
        php -r '
            $f = "/usr/local/etc/kvm/vms.json";
            if (file_exists($f)) {
                $vms = json_decode(file_get_contents($f), true);
                foreach ($vms as $id => $vm) {
                    $pid_file = "/var/run/kvm/{$id}.pid";
                    $status = "STOPPED";
                    $pid = "";
                    if (file_exists($pid_file)) {
                        $p = trim(file_get_contents($pid_file));
                        if ($p && posix_kill((int)$p, 0)) {
                            $status = "RUNNING";
                            $pid = $p;
                        }
                    }
                    echo sprintf("%-15s %-10s %-8s %s\n", $id, $status, $pid, $vm["name"] ?? "");
                }
            }
        '
    fi
}

# ------------------------------------------------------------------------------
# Hapus Virtual Machine & Seluruh Virtual Disk (Blokir penghapusan aaPanel)
# ------------------------------------------------------------------------------
delete_vm() {
    VM_ID="$1"
    if [ "${VM_ID}" = "aapanel" ]; then
        echo "ERROR: Virtual Machine 'aaPanel' adalah VM bawaan default pfSense dan TIDAK BISA DIHAPUS!"
        exit 1
    fi

    echo "[*] Menghentikan VM '${VM_ID}' jika sedang aktif..."
    stop_vm "${VM_ID}" 2>/dev/null || true

    # Dapatkan path disk virtual dan media ISO sebelum konfigurasi dihapus
    DISK_PATH=$(php -r '
        $id = $argv[1];
        $f = "/usr/local/etc/kvm/vms.json";
        if (file_exists($f)) {
            $data = json_decode(file_get_contents($f), true);
            echo $data[$id]["disk_path"] ?? "";
        }
    ' "${VM_ID}" 2>/dev/null || true)

    ISO_PATH=$(php -r '
        $id = $argv[1];
        $f = "/usr/local/etc/kvm/vms.json";
        if (file_exists($f)) {
            $data = json_decode(file_get_contents($f), true);
            echo $data[$id]["iso_path"] ?? "";
        }
    ' "${VM_ID}" 2>/dev/null || true)

    # 1. Hapus berkas virtual disk
    if [ -n "${DISK_PATH}" ] && [ -f "${DISK_PATH}" ]; then
        echo "[*] Menghapus berkas virtual disk: ${DISK_PATH}..."
        rm -f "${DISK_PATH}"
    fi

    # 2. Hapus direktori VM jika ada
    VM_DIR="${VM_BASE_DIR}/${VM_ID}"
    if [ -d "${VM_DIR}" ]; then
        echo "[*] Menghapus direktori data VM: ${VM_DIR}..."
        rm -rf "${VM_DIR}"
    fi

    # 3. Hapus media installer ISO/IMG jika ada dan tidak dipakai VM lain
    if [ -n "${ISO_PATH}" ] && [ -f "${ISO_PATH}" ]; then
        USED_BY_OTHER=$(php -r '
            $id = $argv[1];
            $iso = $argv[2];
            $f = "/usr/local/etc/kvm/vms.json";
            if (file_exists($f)) {
                $data = json_decode(file_get_contents($f), true);
                foreach ($data as $k => $v) {
                    if ($k !== $id && !empty($v["iso_path"]) && $v["iso_path"] === $iso) {
                        echo "yes";
                        exit(0);
                    }
                }
            }
            echo "no";
        ' "${VM_ID}" "${ISO_PATH}" 2>/dev/null || true)

        if [ "${USED_BY_OTHER}" != "yes" ]; then
            echo "[*] Menghapus media installer ISO (${ISO_PATH}) agar tidak memenuhi penyimpanan..."
            rm -f "${ISO_PATH}"
        fi
    fi

    # 4. Hapus berkas supervisor, PID, dan log
    rm -f "${RUN_DIR}/${VM_ID}.pid" "${LOG_DIR}/${VM_ID}.log" "${RUN_DIR}/supervisor_${VM_ID}.sh"

    # 5. Hapus dari vms.json
    php -r '
        $id = $argv[1];
        $f = "/usr/local/etc/kvm/vms.json";
        if (file_exists($f)) {
            $data = json_decode(file_get_contents($f), true);
            if (isset($data[$id])) {
                if (!empty($data[$id]["is_default"])) {
                    fwrite(STDERR, "ERROR: Default VM cannot be deleted.\n");
                    exit(1);
                }
                unset($data[$id]);
                file_put_contents($f, json_encode($data, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES));
                echo "[✓] VM {$id} dan seluruh virtual disk berhasil dibersihkan dari pfSense.\n";
            }
        }
    ' "${VM_ID}"
}

# ------------------------------------------------------------------------------
# Lepas Media Installer & Hapus Berkas ISO dari Disk (Clean Garbage)
# ------------------------------------------------------------------------------
eject_iso() {
    VM_ID="$1"
    if [ -z "${VM_ID}" ]; then
        echo "Error: Masukkan ID Virtual Machine!"
        exit 1
    fi
    php -r '
        $id = $argv[1];
        $f = "/usr/local/etc/kvm/vms.json";
        if (file_exists($f)) {
            $data = json_decode(file_get_contents($f), true);
            if (isset($data[$id])) {
                $iso = $data[$id]["iso_path"] ?? "";
                $data[$id]["iso_path"] = "";
                $data[$id]["install_mode"] = "disk";
                file_put_contents($f, json_encode($data, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES));

                if (!empty($iso) && file_exists($iso)) {
                    // Cek apakah dipakai VM lain
                    $used = false;
                    foreach ($data as $k => $v) {
                        if ($k !== $id && !empty($v["iso_path"]) && $v["iso_path"] === $iso) {
                            $used = true;
                            break;
                        }
                    }
                    if (!$used) {
                        @unlink($iso);
                        echo "[✓] Media installer ({$iso}) berhasil dilepas dan berkas fisik dihapus agar hemat ruang disk.\n";
                        exit(0);
                    }
                }
                echo "[✓] Media installer berhasil dilepas dari VM {$id}.\n";
            }
        }
    ' "${VM_ID}"
}

# ------------------------------------------------------------------------------
# Bersihkan Seluruh Sampah Image ISO Installer
# ------------------------------------------------------------------------------
purge_images() {
    echo "[*] Membersihkan seluruh berkas installer ISO/IMG di ${IMAGES_DIR}..."
    rm -rf "${IMAGES_DIR}"/*
    php -r '
        $f = "/usr/local/etc/kvm/vms.json";
        if (file_exists($f)) {
            $data = json_decode(file_get_contents($f), true);
            foreach ($data as $k => &$v) {
                if (!empty($v["iso_path"])) {
                    $v["iso_path"] = "";
                    $v["install_mode"] = "disk";
                }
            }
            file_put_contents($f, json_encode($data, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES));
        }
    '
    echo "[✓] Seluruh sampah berkas ISO installer berhasil dibersihkan dari penyimpanan."
}

# ------------------------------------------------------------------------------
# Autostart semua VM yang diatur autostart: true
# ------------------------------------------------------------------------------
autostart_vms() {
    init_config
    setup_hypervisor
    php -r '
        $f = "/usr/local/etc/kvm/vms.json";
        if (file_exists($f)) {
            $data = json_decode(file_get_contents($f), true);
            foreach ($data as $id => $vm) {
                if (!empty($vm["autostart"])) {
                    echo "[*] Memulai autostart VM: {$id}\n";
                    system("/usr/local/bin/kvm-manager start " . escapeshellarg($id));
                }
            }
        }
    '
}

case "$1" in
    setup)
        setup_hypervisor
        init_config
        ;;
    start)
        start_vm "$2"
        ;;
    stop)
        stop_vm "$2"
        ;;
    restart)
        restart_vm "$2"
        ;;
    status)
        status_vm "$2"
        ;;
    delete)
        delete_vm "$2"
        ;;
    eject-iso|eject|detach-iso)
        eject_iso "$2"
        ;;
    purge-images|purge)
        purge_images
        ;;
    download-image|download)
        download_image "$2" "$3"
        ;;
    list-images|images)
        list_images
        ;;
    delete-image|del-image)
        delete_image "$2"
        ;;
    autostart)
        autostart_vms
        ;;
    install-aapanel|install-panel)
        echo "[*] Menjalankan installer resmi aaPanel (https://www.aapanel.com)..."
        URL="https://www.aapanel.com/script/install_panel_en.sh"
        if [ -f /usr/bin/curl ]; then
            curl -ksSO "$URL"
        else
            fetch -o install_panel_en.sh "$URL" || wget --no-check-certificate -O install_panel_en.sh "$URL"
        fi
        if [ ! -s install_panel_en.sh ] && [ -f /usr/local/share/aapanel/install_panel_en.sh ]; then
            echo "[*] Menggunakan installer resmi aaPanel offline bundle..."
            cp /usr/local/share/aapanel/install_panel_en.sh ./install_panel_en.sh
        fi
        bash install_panel_en.sh ipssl
        ;;
    *)
        echo "Penggunaan: kvm-manager {setup|start <id>|stop <id>|restart <id>|status [id]|delete <id>|eject-iso <id>|purge-images|download-image <file> <url>|list-images|delete-image <file>|install-aapanel|autostart}"
        exit 1
        ;;
esac

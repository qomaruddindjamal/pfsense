INSTALL_INC_PATH="/usr/local/libexec/installer"
. "${INSTALL_INC_PATH}/pfSense-common"
. "${INSTALL_INC_PATH}/pfSense-LED"

CERTS_PATH="/etc/ssl/certs"
RESOLV_CONF="/etc/resolv.conf"
BOOTSTRAP_FILES="/etc/master.passwd /etc/group /etc/rc.subr /etc/services \
/etc/shells /bin/kenv /bin/sh /usr/bin/tar /usr/bin/uname /usr/sbin/pkg \
/usr/sbin/service /libexec/ld-elf.so.1"
DIR_INIT_CREATE="/boot /boot/loader.conf.d /cf/conf"

chroot_setup() {
	local _destdir
	[ "${#}" -ne 1 ] && return 1
	_destdir="${1}"

	unset _CHROOT_DIR

	[ -f "${RESOLV_CONF}" ] && /bin/cp -f "${RESOLV_CONF}" "${_destdir}${RESOLV_CONF}" 2>/dev/null || true
	/bin/mkdir -p "${_destdir}/dev"
	/sbin/mount -t devfs -o nocover devfs "${_destdir}/dev" 2>/dev/null || true
	_CHROOT_DIR="${_destdir}"
	return 0
}

chroot_cleanup() {
	if [ -n "${_CHROOT_DIR}" ]; then
		"${UMOUNT}" -f "${_CHROOT_DIR}/dev" 2>/dev/null || true
	fi
	unset _CHROOT_DIR
	return 0
}

pfSense_install() {
	local _destdir _model
	[ "${#}" -lt 1 ] && return 1
	_destdir="${1}"
	[ "${#}" -gt 1 ] && _model="${2}"

	for dir in ${DIR_INIT_CREATE}; do
		[ -d "${_destdir}/${dir}" ] && continue
		mkdir -p "${_destdir}/${dir}" > /dev/null 2>&1
	done

	OFFLINE_PKG_DIR="/packages/All"
	[ ! -d "${OFFLINE_PKG_DIR}" ] && [ -d "/usr/local/share/packages/offline" ] && OFFLINE_PKG_DIR="/usr/local/share/packages/offline"
	[ ! -d "${OFFLINE_PKG_DIR}" ] && [ -d "/pkg" ] && OFFLINE_PKG_DIR="/pkg"

	echo "======================================================================"
	echo "        MEMULAI INSTALASI OFFLINE PFSENSE DARI MEDIA LOKAL            "
	echo "======================================================================"

	# 1. Ekstrak sistem dasar FreeBSD (base.txz)
	echo "[1/6] Memasang sistem operasi dasar FreeBSD..."
	local _base_extracted=0
	if [ -f "/usr/local/share/pfSense/base.txz" ]; then
		/usr/bin/tar -xf "/usr/local/share/pfSense/base.txz" -C "${_destdir}" 2>/dev/null && _base_extracted=1
	elif [ -f "${OFFLINE_PKG_DIR}/base.txz" ]; then
		/usr/bin/tar -xf "${OFFLINE_PKG_DIR}/base.txz" -C "${_destdir}" 2>/dev/null && _base_extracted=1
	fi

	if [ ${_base_extracted} -eq 0 ]; then
		local _bpkg="${OFFLINE_PKG_DIR}/pfSense-base-2.9.0.pkg"
		if [ -f "${_bpkg}" ]; then
			/usr/bin/tar -xf "${_bpkg}" -C "${_destdir}" 2>/dev/null || true
		elif [ -f "${OFFLINE_PKG_DIR}/pfSense-base-2.9.0.pkg.partaa" ]; then
			/bin/cat "${OFFLINE_PKG_DIR}"/pfSense-base-2.9.0.pkg.part* | /usr/bin/tar -xf - -C "${_destdir}" 2>/dev/null || true
		fi
		if [ -f "${_destdir}/usr/local/share/pfSense/base.txz" ]; then
			/usr/bin/tar -xf "${_destdir}/usr/local/share/pfSense/base.txz" -C "${_destdir}" 2>/dev/null && _base_extracted=1
		fi
	fi

	# Ekstrak initial.txz jika tersedia
	if [ -f "${_destdir}/usr/local/share/pfSense/initial.txz" ]; then
		/usr/bin/tar -xf "${_destdir}/usr/local/share/pfSense/initial.txz" -C "${_destdir}" 2>/dev/null || true
	elif [ -f "/usr/local/share/pfSense/initial.txz" ]; then
		/usr/bin/tar -xf "/usr/local/share/pfSense/initial.txz" -C "${_destdir}" 2>/dev/null || true
	fi

	# 2. Ekstrak Kernel dan Bootloader pfSense
	echo "[2/6] Memasang Kernel dan Bootloader pfSense..."
	for _kpkg in "${OFFLINE_PKG_DIR}"/pfSense-kernel-*.pkg; do
		if [ -f "${_kpkg}" ]; then
			echo "  -> Memasang $(basename "${_kpkg}")..."
			/usr/bin/tar -xf "${_kpkg}" -C "${_destdir}" 2>/dev/null || true
			break
		fi
	done
	for _bpkg in "${OFFLINE_PKG_DIR}"/pfSense-boot-*.pkg; do
		if [ -f "${_bpkg}" ]; then
			echo "  -> Memasang $(basename "${_bpkg}")..."
			/usr/bin/tar -xf "${_bpkg}" -C "${_destdir}" 2>/dev/null || true
			break
		fi
	done

	# 3. Ekstrak Konfigurasi Awal dan Sistem GUI pfSense
	echo "[3/6] Memasang Konfigurasi Awal dan Sistem GUI pfSense..."
	for _cpkg in "${OFFLINE_PKG_DIR}"/pfSense-default-config-*.pkg; do
		if [ -f "${_cpkg}" ]; then
			echo "  -> Memasang $(basename "${_cpkg}")..."
			/usr/bin/tar -xf "${_cpkg}" -C "${_destdir}" 2>/dev/null || true
			break
		fi
	done
	for _spkg in "${OFFLINE_PKG_DIR}"/pfSense-system-*.pkg "${OFFLINE_PKG_DIR}"/pfSense-2.9.0.pkg; do
		if [ -f "${_spkg}" ]; then
			echo "  -> Memasang $(basename "${_spkg}")..."
			/usr/bin/tar -xf "${_spkg}" -C "${_destdir}" 2>/dev/null || true
		fi
	done

	# 4. Ekstrak seluruh runtime packages pfSense (PHP 8.5, WebConfigurator, Daemons, Tools)
	echo "[4/6] Memasang runtime packages pfSense..."
	if [ -d "${OFFLINE_PKG_DIR}" ]; then
		for _pkg in "${OFFLINE_PKG_DIR}"/*.pkg; do
			[ ! -f "${_pkg}" ] && continue
			case "${_pkg}" in
				*pfSense-base*|*wireguard*|*xray*|*kvm*)
					continue
					;;
				*)
					/usr/bin/tar -xf "${_pkg}" -C "${_destdir}" 2>/dev/null || true
					;;
			esac
		done
	fi

	# 5. Ekstrak Paket Tambahan Offline (WireGuard, Xray-core, KVM)
	echo "[5/6] Memasang Paket Tambahan Offline (WireGuard, Xray-core, KVM aaPanel)..."
	for _custom in wireguard-pfsense.pkg xray-pfsense.pkg kvm.pkg pfSense-pkg-WireGuard-*.pkg; do
		for _dir in "${OFFLINE_PKG_DIR}" /pkg /usr/local/share/packages/offline; do
			for _f in "${_dir}"/${_custom}; do
				if [ -f "${_f}" ]; then
					echo "  -> Memasang $(basename "${_f}")..."
					/usr/bin/tar -xf "${_f}" -C "${_destdir}" 2>/dev/null || true
					break
				fi
			done
		done
	done

	# Pastikan file WebGUI dan XML deskriptor paket tambahan terpasang
	/bin/mkdir -p "${_destdir}/usr/local/www" "${_destdir}/usr/local/pkg" "${_destdir}/usr/local/www/css"
	for _p in /usr/local/www/vpn_wg.php /usr/local/www/vpn_xray.php /usr/local/www/services_virtual.php /usr/local/www/head.inc /usr/local/www/foot.inc; do
		[ -f "${_p}" ] && /bin/cp -f "${_p}" "${_destdir}/usr/local/www/" 2>/dev/null || true
	done
	for _x in /usr/local/pkg/wireguard.xml /usr/local/pkg/xray.xml /usr/local/pkg/virtual.xml; do
		[ -f "${_x}" ] && /bin/cp -f "${_x}" "${_destdir}/usr/local/pkg/" 2>/dev/null || true
	done
	[ -f /usr/local/www/css/sidebar-layout.css ] && /bin/cp -f /usr/local/www/css/sidebar-layout.css "${_destdir}/usr/local/www/css/sidebar-layout.css" 2>/dev/null || true


	# 6. Pastikan file konfigurasi pfSense dan direktori penting tersedia
	echo "[6/6] Finalisasi konfigurasi sistem..."
	/bin/mkdir -p "${_destdir}/dev" "${_destdir}/proc" "${_destdir}/tmp" "${_destdir}/mnt" "${_destdir}/cf/conf" "${_destdir}/var/db/pkg"
	/bin/chmod 1777 "${_destdir}/tmp" 2>/dev/null || true

	# Salin database paket terdaftar agar kernel dan seluruh paket dikenali sistem
	if [ -f "/var/db/pkg/local.sqlite" ]; then
		/bin/cp -f "/var/db/pkg/local.sqlite" "${_destdir}/var/db/pkg/local.sqlite"
	fi

	# Aktifkan seluruh ekstensi PHP (.ini.sample -> .ini) termasuk gettext, curl, openssl
	if [ -d "${_destdir}/usr/local/etc/php" ]; then
		for _s in "${_destdir}"/usr/local/etc/php/ext-*.ini.sample; do
			[ -f "${_s}" ] && /bin/cp -f "${_s}" "${_s%.sample}" 2>/dev/null || true
		done
	fi

	# Pastikan konfigurasi config.xml ada di /cf/conf dan /conf
	/bin/mkdir -p "${_destdir}/cf/conf" "${_destdir}/conf"
	if [ -f "${_destdir}/conf.default/config.xml" ]; then
		/bin/cp -f "${_destdir}/conf.default/config.xml" "${_destdir}/cf/conf/config.xml"
		/bin/cp -f "${_destdir}/conf.default/config.xml" "${_destdir}/conf/config.xml"
	elif [ -f "/conf.default/config.xml" ]; then
		/bin/cp -f "/conf.default/config.xml" "${_destdir}/cf/conf/config.xml"
		/bin/cp -f "/conf.default/config.xml" "${_destdir}/conf/config.xml"
	fi

	if [ -f "/tmp/recovered_config/config.xml" ]; then
		/bin/cp -f "/tmp/recovered_config/config.xml" "${_destdir}/cf/conf/config.xml"
		/bin/cp -f "/tmp/recovered_config/config.xml" "${_destdir}/conf/config.xml"
	fi

	# Daftarkan WireGuard, Xray-core, dan Virtual Machines ke menu WebGUI di config.xml
	if [ -f "${_destdir}/cf/conf/config.xml" ] && ! grep -q "<installedpackages>" "${_destdir}/cf/conf/config.xml" 2>/dev/null; then
		awk '
		/<\/pfsense>/ {
			print "\t<installedpackages>"
			print "\t\t<package>"
			print "\t\t\t<name>WireGuard</name>"
			print "\t\t\t<descr><![CDATA[WireGuard Fast VPN Service]]></descr>"
			print "\t\t\t<version>1.0.0</version>"
			print "\t\t\t<configurationfile>wireguard.xml</configurationfile>"
			print "\t\t</package>"
			print "\t\t<package>"
			print "\t\t\t<name>xray</name>"
			print "\t\t\t<descr><![CDATA[Xray-core Multi-Protocol Anti-Censorship Service]]></descr>"
			print "\t\t\t<version>1.8.24</version>"
			print "\t\t\t<configurationfile>xray.xml</configurationfile>"
			print "\t\t</package>"
			print "\t\t<package>"
			print "\t\t\t<name>virtual</name>"
			print "\t\t\t<descr><![CDATA[Virtual Machine and aaPanel Manager]]></descr>"
			print "\t\t\t<version>1.0.0</version>"
			print "\t\t\t<configurationfile>virtual.xml</configurationfile>"
			print "\t\t</package>"
			print "\t\t<menu>"
			print "\t\t\t<name>WireGuard</name>"
			print "\t\t\t<section>VPN</section>"
			print "\t\t\t<url>/vpn_wg.php</url>"
			print "\t\t\t<tooltiptext>Manage WireGuard VPN Tunnels and Peers</tooltiptext>"
			print "\t\t</menu>"
			print "\t\t<menu>"
			print "\t\t\t<name>Xray-core</name>"
			print "\t\t\t<section>VPN</section>"
			print "\t\t\t<url>/vpn_xray.php</url>"
			print "\t\t\t<tooltiptext>Configure Xray-core (VLESS, VMess, Trojan, Socks5, TUN and Routing)</tooltiptext>"
			print "\t\t</menu>"
			print "\t\t<menu>"
			print "\t\t\t<name>Virtual Machines</name>"
			print "\t\t\t<section>Services</section>"
			print "\t\t\t<url>/services_virtual.php</url>"
			print "\t\t\t<tooltiptext>Virtual Machine and aaPanel Manager</tooltiptext>"
			print "\t\t</menu>"
			print "\t\t<service>"
			print "\t\t\t<name>wireguard</name>"
			print "\t\t\t<rcfile>wireguard-pfsense</rcfile>"
			print "\t\t\t<executable>wg-quick</executable>"
			print "\t\t\t<description><![CDATA[WireGuard Fast VPN Service]]></description>"
			print "\t\t</service>"
			print "\t\t<service>"
			print "\t\t\t<name>xray</name>"
			print "\t\t\t<rcfile>xray</rcfile>"
			print "\t\t\t<executable>xray</executable>"
			print "\t\t\t<description><![CDATA[Xray-core Multi-Protocol Anti-Censorship Service]]></description>"
			print "\t\t</service>"
			print "\t\t<service>"
			print "\t\t\t<name>virtual</name>"
			print "\t\t\t<rcfile>virtual</rcfile>"
			print "\t\t\t<executable>aapanel-pfsense</executable>"
			print "\t\t\t<description><![CDATA[Virtual Machine and aaPanel Service]]></description>"
			print "\t\t</service>"
			print "\t</installedpackages>"
		}
		{ print }
		' "${_destdir}/cf/conf/config.xml" > "${_destdir}/cf/conf/config.xml.tmp" && \
		/bin/mv -f "${_destdir}/cf/conf/config.xml.tmp" "${_destdir}/cf/conf/config.xml"
		/bin/cp -f "${_destdir}/cf/conf/config.xml" "${_destdir}/conf/config.xml" 2>/dev/null || true
	fi

	# Konfigurasi modul kernel untuk WireGuard, Xray (TUN), dan Hypervisor Bhyve
	[ -f "${_destdir}/boot/loader.conf" ] || touch "${_destdir}/boot/loader.conf"
	for _mod in if_wg if_tun vmm nmdm if_tap if_bridge; do
		if ! grep -q "${_mod}_load=\"YES\"" "${_destdir}/boot/loader.conf" 2>/dev/null; then
			echo "${_mod}_load=\"YES\"" >> "${_destdir}/boot/loader.conf"
		fi
	done


	# Konfigurasi repositori lokal
	/bin/mkdir -p "${_destdir}/usr/local/etc/pkg/repos"
	/bin/cat << 'EOF' > "${_destdir}/usr/local/etc/pkg/repos/pfSense.conf"
FreeBSD: { enabled: no }
pfSense: {
  url: "file:///packages",
  mirror_type: "NONE",
  enabled: yes
}
EOF

	# Set product_name agar seluruh script pfSense mengenali nama sistem
	echo "pfSense" > "${_destdir}/etc/product_name"

	# Direktori runtime yang dibutuhkan daemon pfSense (php-fpm, nginx, var)
	/bin/mkdir -p "${_destdir}/usr/local/var/run" \
	              "${_destdir}/usr/local/var/log" \
	              "${_destdir}/usr/local/lib" \
	              "${_destdir}/var/run" \
	              "${_destdir}/var/etc" \
	              "${_destdir}/var/log/nginx" \
	              "${_destdir}/var/tmp/nginx" \
	              "${_destdir}/usr/local/etc/nginx" \
	              "${_destdir}/usr/local/etc/php" 2>/dev/null || true

	[ -f "${_destdir}/usr/local/etc/php-fpm.conf.default" ] && /bin/cp -f "${_destdir}/usr/local/etc/php-fpm.conf.default" "${_destdir}/usr/local/etc/php-fpm.conf" 2>/dev/null || true
	[ -d "${_destdir}/usr/local/etc/php-fpm.d" ] && [ -f "${_destdir}/usr/local/etc/php-fpm.d/www.conf.default" ] && /bin/cp -f "${_destdir}/usr/local/etc/php-fpm.d/www.conf.default" "${_destdir}/usr/local/etc/php-fpm.d/www.conf" 2>/dev/null || true

	# Salin file konfigurasi grup dan otentikasi FreeBSD/pfSense
	/bin/mkdir -p "${_destdir}/etc" "${_destdir}/root"

	# 1. /etc/shells - wajib memuat /bin/sh dan /etc/rc.initial agar login tidak ditolak PAM
	/bin/cat << 'EOF' > "${_destdir}/etc/shells"
/bin/sh
/bin/csh
/bin/tcsh
/etc/rc.initial
EOF

	# 2. /etc/group - memastikan group wheel:0 dan www:80 serta admins:1999 tersedia
	/bin/cat << 'EOF' > "${_destdir}/etc/group"
wheel:*:0:root,admin
daemon:*:1:
kmem:*:2:
sys:*:3:
tty:*:4:
operator:*:5:root
mail:*:6:

#!/bin/sh
#
# PROVIDE: xray
# REQUIRE: NETWORKING
# KEYWORD: shutdown
#
# Add the following lines to /etc/rc.conf.local to enable xray:
# xray_enable="YES"
# xray_config="/usr/local/etc/xray/config.json"
#

. /etc/rc.subr

name="xray"
rcvar="xray_enable"

load_rc_config $name

: ${xray_enable:="YES"}
: ${xray_config:="/usr/local/etc/xray/config.json"}
: ${xray_user:="root"}

command="/usr/local/bin/xray"
pidfile="/var/run/${name}.pid"

start_cmd="${name}_start"
stop_cmd="${name}_stop"
restart_cmd="${name}_restart"
status_cmd="${name}_status"

xray_start() {
    echo "Starting ${name}..."
    if [ ! -f "${xray_config}" ]; then
        echo "Error: Config file ${xray_config} not found!"
        return 1
    fi
    mkdir -p /var/log/xray
    touch /var/log/xray/access.log /var/log/xray/error.log
    /usr/sbin/daemon -f -p ${pidfile} -u ${xray_user} ${command} run -config ${xray_config}
}

xray_stop() {
    if [ -f "${pidfile}" ]; then
        echo "Stopping ${name}..."
        kill -TERM $(cat ${pidfile}) 2>/dev/null || true
        rm -f ${pidfile}
    else
        killall -TERM xray 2>/dev/null || true
    fi
}

xray_restart() {
    xray_stop
    sleep 1
    xray_start
}

xray_status() {
    if [ -f "${pidfile}" ] && kill -0 $(cat ${pidfile}) 2>/dev/null; then
        echo "${name} is running as pid $(cat ${pidfile})."
        return 0
    elif pgrep -f "/usr/local/bin/xray run" >/dev/null 2>&1; then
        echo "${name} is running."
        return 0
    else
        echo "${name} is not running."
        return 1
    fi
}

run_rc_command "$1"

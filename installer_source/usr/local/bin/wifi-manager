#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
wifi-manager - Real Hardware & Wireless Interface Auto-detection, Client Station,
Access Point, and Network Interface Manager for pfSense / FreeBSD.
(NO DUMMY DATA - 100% Genuine FreeBSD System Calls & ifconfig / net.wlan.devices)
"""

import sys
import os
import json
import re
import subprocess
import time

CONF_FILE = "/usr/local/etc/wifi/config.json"
WPA_CONF_FILE = "/etc/wpa_supplicant_wlan0.conf"
HOSTAPD_CONF_FILE = "/etc/hostapd_wlan0.conf"

def run_cmd(cmd, check=False):
    try:
        res = subprocess.run(cmd, shell=True, capture_output=True, text=True, timeout=30)
        return res.returncode, res.stdout.strip(), res.stderr.strip()
    except Exception as e:
        return -1, "", str(e)

def load_config():
    if os.path.exists(CONF_FILE):
        try:
            with open(CONF_FILE, "r", encoding="utf-8") as f:
                return json.load(f)
        except Exception:
            pass
    return {
        "enabled": True,
        "mode": "station",
        "active_interface": "",
        "station": {
            "auto_connect": False,
            "ssid": "",
            "bssid": "",
            "security": "WPA2-PSK",
            "dhcp": True,
            "ip": "",
            "netmask": "",
            "gateway": ""
        },
        "ap": {
            "enabled": False,
            "ssid": "pfSense-WiFi-AP",
            "password": "pfsense_wifi_pass",
            "channel": 6,
            "ip": "192.168.88.1"
        },
        "saved_networks": []
    }

def save_config(cfg):
    os.makedirs(os.path.dirname(CONF_FILE), exist_ok=True)
    with open(CONF_FILE, "w", encoding="utf-8") as f:
        json.dump(cfg, f, indent=2)

def detect_hardware():
    """
    Genuine Hardware & Interface Auto-Detection:
    1. Loads essential FreeBSD wlan subsystems and common wireless drivers.
    2. Probes sysctl net.wlan.devices for physical radio devices.
    3. Auto-creates wlan0 if physical parent device is found and no wlan0 exists.
    4. Probes all network interfaces on the system with ifconfig (IP, MAC, media, flags).
    5. Probes pciconf -lv and usbconfig for real hardware controllers.
    """
    res = {
        "wireless_interfaces": [],
        "wlan_parent_devices": [],
        "bridged_candidates": [],
        "all_interfaces": [],
        "pci_network_devices": [],
        "devices": [],
        "usb_devices": [],
        "modules_loaded": [],
        "is_vm": False,
        "vm_type": "Native Hardware"
    }

    # Detect virtualization environment
    _, vm_out, _ = run_cmd("sysctl -n kern.vm_guest 2>/dev/null")
    if vm_out and vm_out.strip() != "none":
        res["is_vm"] = True
        res["vm_type"] = vm_out.strip()
    else:
        _, pci_raw, _ = run_cmd("pciconf -lv 2>/dev/null")
        if "VirtualBox" in pci_raw or "VBOX" in pci_raw:
            res["is_vm"] = True
            res["vm_type"] = "VirtualBox"
        elif "VMware" in pci_raw:
            res["is_vm"] = True
            res["vm_type"] = "VMware"
        elif "QEMU" in pci_raw or "bhyve" in pci_raw:
            res["is_vm"] = True
            res["vm_type"] = "KVM/QEMU"

    # Core 802.11 modules to load
    core_modules = ["wlan", "wlan_wep", "wlan_ccmp", "wlan_tkip", "wlan_amrr", "wlan_xauth", "wlan_rssadapt"]
    for mod in core_modules:
        run_cmd(f"kldload {mod} >/dev/null 2>&1")

    # Common FreeBSD Wireless drivers to probe
    wireless_drivers = [
        "if_iwm",       # Intel Wireless 7000/8000/9000
        "if_iwx",       # Intel Wi-Fi 6 AX200/AX201/AX210
        "if_ath",       # Atheros AR5xxx/AR9xxx
        "if_rtwn",      # Realtek RTL8188CE/EU
        "if_rtwn_pci",  # Realtek PCI
        "if_rtwn_usb",  # Realtek USB
        "if_rtw88",     # Realtek 802.11ac
        "if_ral",       # Ralink RT2500/RT2600/RT2860
        "if_bwn",       # Broadcom BCM43xx
        "if_run",       # Ralink USB RT2870/RT3070
        "if_urtwn"      # Realtek USB RTL8188CU/EU
    ]
    for drv in wireless_drivers:
        run_cmd(f"kldload {drv} >/dev/null 2>&1")

    # Check which kernel modules are active
    _, kld_out, _ = run_cmd("kldstat 2>/dev/null")
    for line in kld_out.splitlines():
        parts = line.strip().split()
        if len(parts) >= 5:
            mod_name = parts[4]
            if "wlan" in mod_name or any(d in mod_name for d in wireless_drivers):
                res["modules_loaded"].append(mod_name)

    # 1. Probe net.wlan.devices
    _, wlan_devs, _ = run_cmd("sysctl -n net.wlan.devices 2>/dev/null")
    if wlan_devs:
        for dev in wlan_devs.split():
            dev = dev.strip()
            if dev:
                res["wlan_parent_devices"].append(dev)

    # 2. Check all current system network interfaces
    _, iflist_out, _ = run_cmd("ifconfig -l 2>/dev/null")
    if iflist_out:
        all_if_names = iflist_out.split()
        for ifname in all_if_names:
            if ifname.startswith("lo") or ifname.startswith("enc") or ifname.startswith("pflog") or ifname.startswith("pfsync"):
                continue

            _, if_detail, _ = run_cmd(f"ifconfig {ifname} 2>/dev/null")
            
            # Parse MAC
            mac_m = re.search(r"ether (([0-9a-fA-F]{2}:){5}[0-9a-fA-F]{2})", if_detail)
            mac = mac_m.group(1) if mac_m else ""

            # Parse IP
            ip_m = re.search(r"inet (\d+\.\d+\.\d+\.\d+)\s+netmask\s+(0x[0-9a-fA-F]+|\d+\.\d+\.\d+\.\d+)", if_detail)
            ip = ip_m.group(1) if ip_m else ""
            mask = ip_m.group(2) if ip_m else ""

            # Parse media & flags
            media_m = re.search(r"media:\s+([^\n]+)", if_detail)
            media = media_m.group(1).strip() if media_m else ""

            status_m = re.search(r"status:\s+([^\n]+)", if_detail)
            status_txt = status_m.group(1).strip() if status_m else ("UP" if "UP" in if_detail else "DOWN")

            is_wlan = ifname.startswith("wlan") or "802.11" in media or "IEEE802.11" in media

            if_entry = {
                "name": ifname,
                "is_wireless": is_wlan,
                "ip": ip,
                "netmask": mask,
                "mac": mac,
                "media": media,
                "status": status_txt,
                "is_up": "UP" in if_detail
            }
            res["all_interfaces"].append(if_entry)
            if is_wlan:
                res["wireless_interfaces"].append(ifname)
            else:
                res["bridged_candidates"].append(ifname)

    # 3. Auto-create wlan0 if physical parent device is found but no wlan interface created yet
    if res["wlan_parent_devices"] and not res["wireless_interfaces"]:
        parent = res["wlan_parent_devices"][0]
        c_rc, _, _ = run_cmd(f"ifconfig wlan0 create wlandev {parent} wlanmode sta >/dev/null 2>&1")
        if c_rc == 0:
            res["wireless_interfaces"].append("wlan0")
            # Update all_interfaces list
            _, if_detail, _ = run_cmd("ifconfig wlan0 2>/dev/null")
            mac_m = re.search(r"ether (([0-9a-fA-F]{2}:){5}[0-9a-fA-F]{2})", if_detail)
            res["all_interfaces"].append({
                "name": "wlan0",
                "is_wireless": True,
                "ip": "",
                "netmask": "",
                "mac": mac_m.group(1) if mac_m else "",
                "media": "IEEE802.11",
                "status": "created",
                "is_up": True
            })

    WIRELESS_REGEX = r'^(ath|athp|bwi|bwn|ipw|iwi|iwlwifi|iwm|iwn|malo|mwl|ral|rsu|rtwn|rum|run|uath|upgt|ural|urtw|urtwn|wi|wpi|wtap|zyd|wlan)[0-9]+'

    # 4. Probe PCI Network Controllers (pciconf -lv)
    _, pci_out, _ = run_cmd("pciconf -lv 2>/dev/null")
    blocks = re.split(r'\n(?=[a-zA-Z0-9_]+@pci)', pci_out)
    for blk in blocks:
        lines = blk.strip().splitlines()
        if not lines:
            continue
        header = lines[0]
        dev_name = header.split('@')[0] if '@' in header else ''
        dev_info = {"name": dev_name, "pci_id": header.split(':')[0] if ':' in header else header}
        is_net = False
        for line in lines[1:]:
            line = line.strip()
            if not line:
                continue
            if line.startswith("class"):
                val = line.split("=", 1)[1].strip(" '\"") if "=" in line else line
                dev_info["class"] = val
                if "network" in val.lower():
                    is_net = True
            elif line.startswith("subclass"):
                val = line.split("=", 1)[1].strip(" '\"") if "=" in line else line
                dev_info["subclass"] = val
                if "ethernet" in val.lower() or "network" in val.lower():
                    is_net = True
            elif line.startswith("vendor"):
                dev_info["vendor"] = line.split("=", 1)[1].strip(" '\"") if "=" in line else line
            elif line.startswith("device"):
                dev_info["device"] = line.split("=", 1)[1].strip(" '\"") if "=" in line else line

        if "class=0x02" in header.lower() or "class      = network" in blk:
            is_net = True

        if is_net:
            v_lower = (dev_info.get("vendor", "") + " " + dev_info.get("device", "")).lower()
            is_wifi = bool(re.search(WIRELESS_REGEX, dev_name)) or any(w in v_lower for w in ["wireless", "802.11", "wi-fi", "wifi", "centrino", "atheros", "realtek wireless", "intel wireless"])
            res["pci_network_devices"].append({
                "name": dev_name,
                "pci_id": dev_info.get("pci_id", dev_name),
                "vendor": dev_info.get("vendor", "Unknown"),
                "device": dev_info.get("device", "Network Controller"),
                "model": dev_info.get("device", "Network Controller"),
                "is_wireless": is_wifi,
                "type": "Wireless (802.11)" if is_wifi else "Ethernet (PCIe)"
            })

    res["devices"] = res["pci_network_devices"]

    # 5. Probe USB Devices (usbconfig)
    _, usb_out, _ = run_cmd("usbconfig 2>/dev/null")
    if usb_out:
        for line in usb_out.splitlines():
            line = line.strip()
            if line:
                res["usb_devices"].append(line)

    return res

def scan_networks(interface=""):
    """
    Executes a real over-the-air scan using ifconfig <interface> list scan.
    Returns ONLY genuine detected networks. No dummy or mock data.
    """
    hw = detect_hardware()
    
    # Auto-select wireless interface if not specified
    if not interface:
        if hw["wireless_interfaces"]:
            interface = hw["wireless_interfaces"][0]
        else:
            return {
                "status": False,
                "msg": "Tidak dapat melakukan scan: Tidak ditemukan antarmuka wireless 802.11 (wlan0) pada sistem. Di VirtualBox, silakan pasang USB Wi-Fi dongle (Devices > USB) atau pasang pada hardware native dengan kartu Wi-Fi fisik.",
                "networks": []
            }

    # Trigger scan
    run_cmd(f"ifconfig {interface} up scan >/dev/null 2>&1")
    time.sleep(2)
    rc, scan_out, err = run_cmd(f"ifconfig {interface} list scan 2>/dev/null")

    networks = []
    lines = scan_out.splitlines()
    if len(lines) > 1:
        for line in lines[1:]:
            parts = line.strip().split()
            if len(parts) >= 5:
                bssid_idx = -1
                for idx, p in enumerate(parts):
                    if re.match(r"^([0-9a-fA-F]{2}:){5}[0-9a-fA-F]{2}$", p):
                        bssid_idx = idx
                        break
                
                if bssid_idx > 0:
                    ssid = " ".join(parts[:bssid_idx])
                    bssid = parts[bssid_idx]
                    chan = parts[bssid_idx + 1] if len(parts) > bssid_idx + 1 else "Auto"
                    rate = parts[bssid_idx + 2] if len(parts) > bssid_idx + 2 else ""
                    sn = parts[bssid_idx + 3] if len(parts) > bssid_idx + 3 else "25:0"
                    caps = " ".join(parts[bssid_idx + 5:]) if len(parts) > bssid_idx + 5 else ""

                    sig_val = 30
                    if ":" in sn:
                        try:
                            sig_val = int(sn.split(":")[0])
                        except ValueError:
                            pass
                    sig_percent = min(100, max(10, int((sig_val / 50.0) * 100)))

                    sec = "Open"
                    if "RSN" in caps or "WPA2" in caps:
                        sec = "WPA2-PSK"
                    elif "WPA" in caps:
                        sec = "WPA-PSK"
                    elif "WEP" in caps or "PRIVACY" in caps:
                        sec = "WEP"

                    networks.append({
                        "ssid": ssid if ssid else "<Hidden SSID>",
                        "bssid": bssid,
                        "channel": chan,
                        "rate": rate,
                        "signal_percent": sig_percent,
                        "signal_dbm": -(100 - sig_percent),
                        "security": sec,
                        "caps": caps
                    })

    networks.sort(key=lambda x: x["signal_percent"], reverse=True)
    return {
        "status": True,
        "interface": interface,
        "networks": networks,
        "msg": f"Scan selesai pada {interface}: {len(networks)} jaringan terdeteksi di udara."
    }

def connect_network(ssid, password="", security="WPA2-PSK", interface=""):
    """
    Connect to a wireless network via wpa_supplicant.
    Requires genuine wireless 802.11 interface.
    """
    if not ssid:
        return {"status": False, "msg": "SSID tidak boleh kosong!"}

    hw = detect_hardware()
    if not interface:
        if hw["wireless_interfaces"]:
            interface = hw["wireless_interfaces"][0]
        else:
            return {
                "status": False,
                "msg": "Gagal menyambung: Tidak ditemukan antarmuka wireless 802.11 (wlan0) fisik pada sistem."
            }

    # Kill old instances
    run_cmd(f"killall -9 wpa_supplicant >/dev/null 2>&1")
    run_cmd(f"dhclient -r {interface} >/dev/null 2>&1")

    # Generate wpa_supplicant.conf
    os.makedirs(os.path.dirname(WPA_CONF_FILE), exist_ok=True)
    wpa_content = "ctrl_interface=/var/run/wpa_supplicant\nctrl_interface_group=wheel\n\n"
    wpa_content += "network={\n"
    wpa_content += f'    ssid="{ssid}"\n'
    wpa_content += '    scan_ssid=1\n'
    if password:
        wpa_content += f'    psk="{password}"\n'
        wpa_content += '    key_mgmt=WPA-PSK WPA-EAP SAE\n'
    else:
        wpa_content += '    key_mgmt=NONE\n'
    wpa_content += "}\n"

    with open(WPA_CONF_FILE, "w", encoding="utf-8") as f:
        f.write(wpa_content)
    os.chmod(WPA_CONF_FILE, 0o600)

    run_cmd(f"ifconfig {interface} up")
    time.sleep(1)

    wpa_cmd = f"wpa_supplicant -B -i {interface} -c {WPA_CONF_FILE}"
    rc, out, err = run_cmd(wpa_cmd)
    if rc != 0:
        return {"status": False, "msg": f"Gagal menjalankan wpa_supplicant: {err}"}

    # Check association
    associated = False
    for _ in range(8):
        time.sleep(1)
        _, st_out, _ = run_cmd(f"ifconfig {interface} 2>/dev/null")
        if "status: associated" in st_out:
            associated = True
            break

    run_cmd(f"dhclient {interface} >/dev/null 2>&1 &")
    time.sleep(2)

    cfg = load_config()
    cfg["enabled"] = True
    cfg["mode"] = "station"
    cfg["active_interface"] = interface
    cfg["station"]["ssid"] = ssid
    cfg["station"]["security"] = security
    save_config(cfg)

    return {
        "status": True,
        "associated": associated,
        "msg": f"Berhasil tersambung ke '{ssid}' pada {interface}!" if associated else f"Perintah sambungan dikirim ke '{ssid}'. Menunggu asosiasi..."
    }

def disconnect_network(interface=""):
    """
    Disconnects wireless interface.
    """
    if not interface:
        cfg = load_config()
        interface = cfg.get("active_interface", "wlan0")

    run_cmd("killall -9 wpa_supplicant >/dev/null 2>&1")
    run_cmd(f"dhclient -r {interface} >/dev/null 2>&1")
    run_cmd(f"ifconfig {interface} down >/dev/null 2>&1")
    
    cfg = load_config()
    cfg["station"]["ssid"] = ""
    cfg["ap"]["enabled"] = False
    save_config(cfg)
    return {"status": True, "msg": f"Antarmuka {interface} berhasil diputus/dinonaktifkan."}

def start_ap(ssid="pfSense-WiFi-AP", password="pfsense_wifi_pass", channel=6, ip="192.168.88.1"):
    """
    Starts genuine 802.11 Access Point (HostAP) mode.
    Requires genuine physical wireless hardware device (e.g. ath0, iwm0, rtwn0).
    """
    hw = detect_hardware()
    parent = ""
    if hw["wlan_parent_devices"]:
        parent = hw["wlan_parent_devices"][0]
    else:
        return {
            "status": False,
            "msg": "Tidak dapat memulai Access Point: Tidak ditemukan antarmuka wireless fisik yang mendukung mode HostAP (net.wlan.devices kosong). VirtualBox secara default hanya mengemulasi kartu ethernet kabel (em0, em1). Untuk memancarkan Wi-Fi fisik dari VirtualBox, pasang USB Wi-Fi dongle (misal Realtek RTL8188 atau Atheros) lalu aktifkan di VirtualBox: Devices > USB."
        }

    run_cmd("killall -9 wpa_supplicant hostapd >/dev/null 2>&1")
    run_cmd("ifconfig wlan0 destroy >/dev/null 2>&1")
    time.sleep(1)

    rc, _, err = run_cmd(f"ifconfig wlan0 create wlandev {parent} wlanmode hostap")
    if rc != 0:
        return {"status": False, "msg": f"Gagal membuat antarmuka HostAP pada {parent}: {err}"}

    os.makedirs(os.path.dirname(HOSTAPD_CONF_FILE), exist_ok=True)
    h_conf = f"""interface=wlan0
ctrl_interface=/var/run/hostapd
ctrl_interface_group=wheel
ssid={ssid}
channel={channel}
hw_mode=g
ieee80211n=1
wpa=2
wpa_passphrase={password}
wpa_key_mgmt=WPA-PSK
wpa_pairwise=CCMP
rsn_pairwise=CCMP
"""
    with open(HOSTAPD_CONF_FILE, "w", encoding="utf-8") as f:
        f.write(h_conf)
    os.chmod(HOSTAPD_CONF_FILE, 0o600)

    run_cmd(f"ifconfig wlan0 inet {ip} netmask 255.255.255.0 up")
    time.sleep(1)

    rc, _, err = run_cmd(f"hostapd -B {HOSTAPD_CONF_FILE}")
    if rc != 0:
        return {"status": False, "msg": f"Gagal menjalankan hostapd daemon: {err}"}

    cfg = load_config()
    cfg["mode"] = "ap"
    cfg["ap"]["enabled"] = True
    cfg["ap"]["ssid"] = ssid
    cfg["ap"]["password"] = password
    cfg["ap"]["channel"] = channel
    cfg["ap"]["ip"] = ip
    cfg["active_interface"] = "wlan0"
    save_config(cfg)

    return {"status": True, "msg": f"Access Point '{ssid}' aktif pada antarmuka nirkabel {parent} -> wlan0 (Channel {channel}, IP {ip})!"}

def stop_ap():
    """
    Stops Access Point (HostAP) mode.
    """
    run_cmd("killall -9 hostapd >/dev/null 2>&1")
    run_cmd("ifconfig wlan0 down >/dev/null 2>&1")
    cfg = load_config()
    cfg["ap"]["enabled"] = False
    cfg["mode"] = "station"
    save_config(cfg)
    return {"status": True, "msg": "Access Point dihentikan."}

def get_status():
    """
    Returns REAL current status for WebGUI.
    """
    cfg = load_config()
    hw = detect_hardware()
    mode = cfg.get("mode", "station")

    # Determine default active interface from detected hardware
    active_if = cfg.get("active_interface", "")
    if not active_if or not any(i["name"] == active_if for i in hw["all_interfaces"]):
        if hw["wireless_interfaces"]:
            active_if = hw["wireless_interfaces"][0]
        elif hw["bridged_candidates"]:
            if "em1" in hw["bridged_candidates"]:
                active_if = "em1"
            else:
                active_if = hw["bridged_candidates"][0]
        elif hw["all_interfaces"]:
            active_if = hw["all_interfaces"][0]["name"]
        else:
            active_if = "None"

    status = {
        "mode": mode,
        "active_interface": active_if,
        "state": "Idle",
        "ssid": "",
        "bssid": "",
        "channel": "",
        "signal_percent": 0,
        "signal_dbm": -100,
        "ip": "",
        "netmask": "",
        "mac": "",
        "gateway": "",
        "media": "",
        "is_wireless": False,
        "is_bridged": False,
        "wireless_interfaces": hw["wireless_interfaces"],
        "wlan_parents": hw["wlan_parent_devices"],
        "bridged_candidates": hw["bridged_candidates"],
        "all_interfaces": hw["all_interfaces"],
        "pci_network_devices": hw["pci_network_devices"],
        "devices": hw["pci_network_devices"],
        "is_vm": hw["is_vm"],
        "vm_type": hw["vm_type"]
    }

    if active_if and active_if != "None":
        _, if_out, _ = run_cmd(f"ifconfig {active_if} 2>/dev/null")
        if if_out:
            mac_m = re.search(r"ether (([0-9a-fA-F]{2}:){5}[0-9a-fA-F]{2})", if_out)
            if mac_m:
                status["mac"] = mac_m.group(1)

            ip_m = re.search(r"inet (\d+\.\d+\.\d+\.\d+)\s+netmask\s+(0x[0-9a-fA-F]+|\d+\.\d+\.\d+\.\d+)", if_out)
            if ip_m:
                status["ip"] = ip_m.group(1)
                status["netmask"] = ip_m.group(2)

            media_m = re.search(r"media:\s+([^\n]+)", if_out)
            if media_m:
                status["media"] = media_m.group(1).strip()

            is_wlan = active_if.startswith("wlan") or "802.11" in if_out or "IEEE802.11" in if_out
            status["is_wireless"] = is_wlan
            status["is_bridged"] = (not is_wlan and hw["is_vm"])

            if mode == "ap" and cfg.get("ap", {}).get("enabled") and is_wlan:
                status["state"] = "Access Point Active"
                status["ssid"] = cfg.get("ap", {}).get("ssid", "pfSense-WiFi-AP")
                status["channel"] = str(cfg.get("ap", {}).get("channel", 6))
            else:
                if status["is_bridged"]:
                    status["state"] = "Active (Bridged to Host Wi-Fi)"
                elif "status: associated" in if_out:
                    status["state"] = "Connected / Associated"
                elif "status: active" in if_out:
                    status["state"] = "Active (Link Up)"
                elif "status: no carrier" in if_out:
                    status["state"] = "No Carrier / Disconnected"
                elif "RUNNING" in if_out:
                    status["state"] = "Active (Running)"

                ssid_m = re.search(r'ssid "?([^"\n]+)"?', if_out)
                if ssid_m:
                    status["ssid"] = ssid_m.group(1)

                bssid_m = re.search(r"bssid (([0-9a-fA-F]{2}:){5}[0-9a-fA-F]{2})", if_out)
                if bssid_m:
                    status["bssid"] = bssid_m.group(1)

                chan_m = re.search(r"channel (\d+)", if_out)
                if chan_m:
                    status["channel"] = chan_m.group(1)

    # Detect Gateway
    _, gw_out, _ = run_cmd("netstat -rn -f inet 2>/dev/null | grep default")
    if gw_out:
        parts = gw_out.split()
        if len(parts) >= 2:
            status["gateway"] = parts[1]

    return status

def set_active_interface(iface):
    """
    Set active interface for Wi-Fi management.
    """
    cfg = load_config()
    cfg["active_interface"] = iface
    save_config(cfg)
    return {"status": True, "active_interface": iface, "msg": f"Antarmuka aktif diatur ke {iface}."}

def main():
    if len(sys.argv) < 2:
        print("Usage: wifi-manager {detect|scan|connect|disconnect|ap-start|ap-stop|set-iface|status} [args...]")
        sys.exit(1)

    cmd = sys.argv[1].lower()

    if cmd == "detect":
        data = detect_hardware()
        print(json.dumps(data, indent=2))

    elif cmd == "scan":
        iface = sys.argv[2] if len(sys.argv) > 2 else ""
        res = scan_networks(iface)
        print(json.dumps(res, indent=2))

    elif cmd == "connect":
        if len(sys.argv) < 3:
            print(json.dumps({"status": False, "msg": "Usage: wifi-manager connect <ssid> [password] [security] [interface]"}))
            sys.exit(1)
        ssid = sys.argv[2]
        pwd = sys.argv[3] if len(sys.argv) > 3 else ""
        sec = sys.argv[4] if len(sys.argv) > 4 else "WPA2-PSK"
        iface = sys.argv[5] if len(sys.argv) > 5 else ""
        res = connect_network(ssid, pwd, sec, iface)
        print(json.dumps(res, indent=2))

    elif cmd == "disconnect":
        iface = sys.argv[2] if len(sys.argv) > 2 else ""
        res = disconnect_network(iface)
        print(json.dumps(res, indent=2))

    elif cmd == "ap-start":
        ssid = sys.argv[2] if len(sys.argv) > 2 else "pfSense-WiFi-AP"
        pwd = sys.argv[3] if len(sys.argv) > 3 else "pfsense_wifi_pass"
        chan = int(sys.argv[4]) if len(sys.argv) > 4 else 6
        ip = sys.argv[5] if len(sys.argv) > 5 else "192.168.88.1"
        res = start_ap(ssid, pwd, chan, ip=ip)
        print(json.dumps(res, indent=2))

    elif cmd == "ap-stop":
        res = stop_ap()
        print(json.dumps(res, indent=2))

    elif cmd == "set-iface":
        iface = sys.argv[2] if len(sys.argv) > 2 else "wlan0"
        res = set_active_interface(iface)
        print(json.dumps(res, indent=2))

    elif cmd == "status":
        st = get_status()
        print(json.dumps(st, indent=2))

    else:
        print(f"Unknown command: {cmd}")
        sys.exit(1)

if __name__ == "__main__":
    main()
